{
  "name": "@avonix/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=65536' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--max-http-header-size=65536' next start",
    "typecheck": "tsc --noEmit",
    "fa:catalog": "node scripts/generate-fa-catalog.mjs",
    "fonts:refresh": "node scripts/refresh-google-fonts.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit migrate",
    "db:rls": "psql \"$ADMIN_DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/lib/db/rls.sql",
    "db:seed": "tsx scripts/seed.ts",
    "platform:bootstrap": "tsx scripts/platform-bootstrap.ts",
    "platform:add-owner": "tsx scripts/platform-add-owner.ts",
    "platform:recover-owner": "tsx scripts/platform-recover-owner.ts",
    "db:test": "./scripts/test-isolation.sh",
    "db:setup": "npm run db:push && npm run db:rls && npm run db:search && npm run db:test && npm run db:seed",
    "test:clients": "tsx scripts/test-clients.ts",
    "test": "npm run db:test && npm run test:clients && npm run test:crm && npm run test:delivery",
    "test:connector": "tsx scripts/test-connector.ts",
    "test:all": "npm run test && npm run test:connector && npm run test:forms && npm run test:organizations && npm run test:reports && npm run test:inbound && npm run test:billing && npm run test:ai",
    "test:crm": "tsx scripts/test-crm.ts",
    "test:delivery": "tsx scripts/test-delivery.ts",
    "test:inbound": "tsx scripts/test-inbound.ts",
    "test:billing": "tsx scripts/test-billing.ts",
    "db:search": "psql \"$ADMIN_DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/lib/db/search.sql",
    "test:ai": "tsx scripts/test-ai.ts",
    "test:forms": "tsx scripts/test-forms.ts",
    "test:organizations": "tsx scripts/test-organizations.ts",
    "test:reports": "tsx scripts/test-reports.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.6.23",
    "fflate": "^0.8.3",
    "next": "^16.2.10",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "postcss": "^8.5.20",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
