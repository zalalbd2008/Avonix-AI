# Google PageSpeed Insights (Dashboard → Performance). API key only — no OAuth.
# Enable "PageSpeed Insights API" in Google Cloud, then create an API key.
PAGESPEED_API_KEY=

# Optional AI adapters (ADR-011)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# --- Google sign-in (Verify with Google) ---
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI (must match exactly):
# Redirect URIs (add both to the same OAuth Web client in Google Cloud Console):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/backups/oauth/google/callback
#   https://YOUR_LIVE_DOMAIN/api/auth/callback/google
#   https://YOUR_LIVE_DOMAIN/api/backups/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Super admin sets GOOGLE_CLIENT_* once — users connect Drive with one click.

# --- Dropbox backup OAuth (same one-click pattern) ---
# App Console: https://www.dropbox.com/developers/apps
# Redirect URI (must match exactly):
#   http://localhost:3000/api/backups/oauth/dropbox/callback
#   https://YOUR_LIVE_DOMAIN/api/backups/oauth/dropbox/callback
# Permissions: account_info.read, files.content.write, files.content.read
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
NEXT_PUBLIC_DROPBOX_APP_KEY=

# --- Microsoft sign-in (Verify with Microsoft / Entra ID) ---
# Portal: https://portal.azure.com → App registrations → New registration
# Redirect URI (Web) — add ALL of:
#   http://localhost:3000/api/auth/callback/microsoft
#   http://localhost:3000/api/backups/oauth/onedrive/callback
#   https://YOUR_LIVE_DOMAIN/api/auth/callback/microsoft
#   https://YOUR_LIVE_DOMAIN/api/backups/oauth/onedrive/callback
# API permissions: Microsoft Graph → Files.ReadWrite, User.Read, offline_access
# MICROSOFT_TENANT_ID: common | organizations | consumers | <tenant-guid>
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# --- Outbound email (verification, password reset, invites) ---
# Prefer SMTP (Gmail App Password / Hostinger / any SMTP), else Resend.
# First match wins: SMTP_* → RESEND_* → local .mail/ (dev only).
EMAIL_FROM=Avonix AI <noreply@yourdomain.com>

# Gmail example (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Or Resend API (https://resend.com) — domain must be verified for custom From:
RESEND_API_KEY=
INBOUND_EMAIL_DOMAIN=inbound.yourdomain.com
INBOUND_WEBHOOK_SECRET=

# Marketplace paid listings (Stripe Checkout one-time). Optional platform fee
# in basis points — 2000 = 20%. Seller Connect payouts are ledger-only for now.
MARKETPLACE_PLATFORM_FEE_BPS=2000

# Protect /api/cron/automation (follow-up + missed chat + uptime). Required in production.
CRON_SECRET=

# Twilio SMS (optional — Auto Rules “Send SMS”)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Platform Telegram bot (users connect with phone only) ---
# Create bot via @BotFather → paste token + username (without @)
# Webhook is set automatically to: {NEXT_PUBLIC_APP_URL}/api/telegram/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Prefer Stripe Price IDs (price_…). Or set a Product ID (prod_…) and the app
# resolves an active recurring price at checkout.
STRIPE_PRODUCT_ID=prod_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Optional yearly prices (falls back to monthly ids if unset)
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
STRIPE_PRICE_AGENCY_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...
# Legacy aliases (still map to Professional)
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# Per-plan products (override STRIPE_PRODUCT_ID when set)
# STRIPE_PRODUCT_STARTER=prod_...
# STRIPE_PRODUCT_PROFESSIONAL=prod_...
# STRIPE_PRODUCT_AGENCY=prod_...
# STRIPE_PRODUCT_ENTERPRISE=prod_...
VOYAGE_API_KEY=
